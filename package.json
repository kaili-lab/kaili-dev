{
  "name": "kaili-dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "pnpm fonts:check && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "check": "pnpm fonts:check && node tooling/audit-tokens.mjs && node tooling/spacing-inventory.mjs --check && pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "pnpm generate-routes && tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:admin": "playwright test -c playwright.admin.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "d1:seed": "wrangler d1 execute kaili-dev --local --file scripts/seed-local-d1.sql",
    "fonts:generate": "node scripts/subset-lxgw-wenkai.mjs",
    "fonts:css": "node scripts/generate-font-css.mjs",
    "fonts:check": "node scripts/check-fonts.mjs",
    "fonts:measure": "node scripts/measure-fonts.mjs slow-3g",
    "fonts:fallback": "node scripts/measure-fonts.mjs fallback",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "drizzle-orm": "0.45.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "^2.0.4",
    "prettier": "^3.9.10",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.70.0"
  }
}
